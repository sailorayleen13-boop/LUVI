# Supabase — see src/lib/supabase/{client,server,admin}.ts
#
# Safe to expose to the browser (RLS-protected, anon key only):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_ — that would ship it to
# the browser bundle. Bypasses Row Level Security entirely; only
# src/lib/supabase/admin.ts (guarded by `import "server-only"`) may read it.
SUPABASE_SERVICE_ROLE_KEY=
